% Run multi-objective optimization for all coalition structures.
%
%   Requirements (download to this folder, see README.md):
%     MRST          (tested with release 2026a)
%     Set-Partition (tested with version 1.6.0)
%     PlatEMO       (tested with release 4.16)
%   Tested with MATLAB R2025b.
%
%   All problem and algorithm settings are in problem_config.m.


%% Set paths to MRST, Set-Partition, and PlatEMO
path_main = pwd; % save current working directory (absolute file path)
addpath(genpath(path_main));   % PlatEMO, Set-Partition, MRST and this repo

% Make sure the Statistics and Machine Learning Toolbox's lhsdesign and auxiliary functions are used
addpath(fullfile(matlabroot, 'toolbox', 'stats', 'stats'), '-begin');
rehash toolboxcache;


%% Initialize MRST (startup first, then modules)
%run(fullfile(path_main, mrst_folder(path_main), 'startup.m'));
startup;
mrstModule add ad-core optimization

%% Settings
cfg = problem_config();
rng(cfg.seed);

% Coalition structures to run. Index 1 is the grand coalition (a single
% objective)
CS_to_run = 1:cfg.num_CS;

% Set to false to reuse a previously computed initialization (Dec_init.mat).
run_init = true;

assert(any(strcmp(cfg.sol_meth, {'MOO', 'WSM'})), 'Unknown sol_meth ''%s''.', cfg.sol_meth);
num_vars = cfg.num_vars;
xlow = cfg.xlow;
xup  = cfg.xup;
lhs  = @(n) (xup - xlow) .* lhsdesign(n, num_vars) + xlow;   % Latin hypercube in [xlow, xup]

% Can choose to run initialization (only), or load existing data if
% available
run_init = true;
run_PF = true;


%% Initialize the physical model setup
[model, schedule, initState, seainfo, other] = make_Bjarmeland_model_inj_only(cfg.num_wells, cfg.num_ctrls, cfg.inj_time);

% The cell pressure limit is set to be 90% of the overburden pressure,
% which is the weight of the fluid and solid layers lying on top of the
% formation we are injecting into.

P_over = computeOverburdenPressure(model.G, model.rock, seainfo.seafloor_depth, model.fluid.rhoWS);
p_lim_fac   = 0.9;
P_limit     = P_over * p_lim_fac;

% Set constraint function.
g1 = @(u) evaluate_pressure_constr(u, P_limit, initState, model, schedule);

% Minimum/maximum availability constraints, later scaled to Mt/year.
xup = cfg.xup;
xlow = cfg.xlow;


%% Folders for saving results
folder_name = [path_main,'/results_', cfg.sol_meth, '_NW_', num2str(cfg.num_wells)];

% Check if folders for saving results already exist
if not(isfolder(folder_name))
    mkdir(folder_name)
end

% Loop over all or subset of coalition structures (no need to do the first
% (grand coal.))
for ind_CS = 2 %CS_to_run

    switch cfg.sol_meth
        case 'MOO'
            folder_name_sub = [folder_name,'/CS_ind_', num2str(ind_CS), '_N', num2str(cfg.N),'_maxFE',num2str(cfg.maxFE),'_SO_init_', num2str(cfg.maxFE_init)];
        case 'WSM'
            folder_name_sub = [folder_name,'/CS_ind_', num2str(ind_CS), '_N', num2str(cfg.N),'_maxFE',num2str(cfg.maxFE)];
    end

    % Check if folders for saving results already exist
    if not(isfolder(folder_name_sub))
        mkdir(folder_name_sub)
    end

    % For the grand coalition, there is no difference between MOO and WSM
    % in the choice of simulation method
    if ind_CS == 1
        % For single-obj opt, use CSO
        opt_meth = @CSO;
        f0 = @(N) [xlow; repmat((xup-xlow),N-1,1).*lhsdesign(N-1,cfg.num_ctrls*cfg.num_wells)+repmat(xlow,N-1,1)];
        obj_fun = @(u) -sum(u(cfg.coal_indices{ind_CS}{1}));
        [Dec, Obj, Con] = platemo('algorithm',opt_meth, 'objFcn',obj_fun,'conFcn',g1, 'encoding', ones(1,cfg.num_wells*cfg.num_ctrls),'lower',xlow,'upper',xup,'initFcn',f0,'N',cfg.N,'maxFE',cfg.maxFE);
        % Save results
        fname = [folder_name_sub,'/Obj.mat'];
        save(fname,'Obj')
        fname = [folder_name_sub,'/Obj.txt'];
        writematrix(Obj,fname);

        fname = [folder_name_sub,'/Dec.mat'];
        save(fname,'Dec')
        fname = [folder_name_sub,'/Dec.txt'];
        writematrix(Dec,fname);

        fname = [folder_name_sub,'/Con.mat'];
        save(fname,'Con')
        fname = [folder_name_sub,'/Con.txt'];
        writematrix(Con,fname);

    elseif ind_CS > 1

        num_coal = numel(cfg.coal_struct_list{ind_CS});
        coal_indices = cfg.coal_indices{ind_CS};
        num_coal = numel(coal_indices);

        switch cfg.sol_meth
            case 'MOO'
                opt_meth = @NSGAII
                % Set objective function
                obj_fun = {@(u) -sum(u(coal_indices{1}))};
                for ind_C = 2:num_coal
                    obj_fun = {obj_fun{1:ind_C-1}, @(u) -sum(u(coal_indices{ind_C}))};
                end

                if run_init
                    % Initialize the MOO with near-extreme points of the
                    % front: one weighted single-objective solve per coalition.
                    tol = 1e-3;
                    wts = tol*ones(num_coal)+(1-tol)*eye(num_coal);
                    % Loop over all weights for the current CS
                    Dec_init = zeros(num_coal, num_vars);
                    for ind_wts = 1:length(wts)
                        % Assemble objective function for the initialization
                        obj_fun_init = @(u) 0;
                        for ind_C = 1:num_coal
                            %obj_fun_init = @(u) obj_fun_init(u) - wts(ind_C,ind_wts)*sum(u(coal_indices{ind_C}));
                            obj_fun_init = @(u) obj_fun_init(u) - wts(ind_C,ind_wts)*sum(u(:,coal_indices{ind_C}),2);
                        end
                        
                        % Initial function using Latin hypercibe sampling
                        f0_SO = @(N) [xlow; repmat((xup-xlow),N-1,1).*lhsdesign(N-1,cfg.num_ctrls*cfg.num_wells)+repmat(xlow,N-1,1)];

                        [Dec_temp Obj_temp Con_temp ] = platemo('algorithm', @CSO, 'objFcn',obj_fun_init,'conFcn',g1, 'encoding', ones(1,cfg.num_wells*cfg.num_ctrls),'lower',xlow,'upper',xup,'N',cfg.N_SO,'maxFE',cfg.maxFE_init, 'initFcn', f0_SO);
                        ind_min_Con = find(Con_temp == min(Con_temp));
                        ind_max_neg_Con = find(Con_temp == max(Con_temp(Con_temp<0)));

                        Dec_init(ind_wts,:) = Dec_temp(ind_max_neg_Con,:);
                    end
                    % Save initialization results
                    fname = [folder_name_sub,'/Dec_init.mat'];
                    save(fname,'Dec_init')
                    fname = [folder_name_sub,'/Dec_init.txt'];
                    writematrix(Dec_init,fname);
                else
                    % If initialization has been precomuted:
                    load([folder_name_sub,'/Dec_init']);
                end

                %Initial function
                f0 = @(N) [Dec_init(1:N<=num_coal,:)*(N<=num_coal); zeros(N-num_coal,num_ctrls*num_wells)*(N>num_coal)]  + [Dec_init(1:min(N,num_coal),:);repmat((xup-xlow),N-num_coal,1).*lhsdesign(N-num_coal,num_ctrls*num_wells)+repmat(xlow,N-num_coal,1)]*(N>num_coal);
                % Optimization
                [Dec Obj Con ] = platemo('algorithm',opt_meth, 'objFcn',obj_fun,'conFcn',g1, 'encoding', ones(1,cfg.num_wells*cfg.num_ctrls),'lower',xlow,'upper',xup,'initFcn',f0,'N',cfg.N,'maxFE',cfg.maxFE);

                % Save results
                fname = [folder_name_sub,'/Obj.mat'];
                save(fname,'Obj')
                fname = [folder_name_sub,'/Obj.txt'];
                writematrix(Obj,fname);

                fname = [folder_name_sub,'/Dec.mat'];
                save(fname,'Dec')
                fname = [folder_name_sub,'/Dec.txt'];
                writematrix(Dec,fname);

                fname = [folder_name_sub,'/Con.mat'];
                save(fname,'Con')
                fname = [folder_name_sub,'/Con.txt'];
                writematrix(Con,fname);

            case 'WSM'

                % Determine a 'resolution' of the discretization of weights of the various
                % coalitions. The weights will then be determined differently depending on
                % the number of coalitions
                % Need to set and loop over weights when using WSM

                K = 10 * (num_coal == 2) + 5 * (num_coal >= 3);
                wts = simplex_grid(num_coal, K);   % num_coal x num_wts, columns sum to 1

                % Loop over all weights for the current CS
                for ind_wts = 1:length(wts)
                    % Assemble objective function
                    obj_fun = @(u) 0;
                    for ind_C = 1:num_coal
                        obj_fun = @(u) obj_fun(u) - wts(ind_C,ind_wts)*sum(u(coal_indices{ind_C}));
                    end

                    % Optimization
                    [Dec Obj Con ] = platemo('algorithm', opt_meth, 'objFcn',obj_fun,'conFcn',g1, 'encoding', ones(1,cfg.num_wells*cfg.num_ctrls),'lower',xlow,'upper', xup,'N',cfg.N,'maxFE',cfg.maxFE);
                    % Reset path after running PlatEMO
                    cd(path_main)
                    fname = [folder_name_sub,'/Obj_',num2str(ind_wts),'.mat'];
                    save(fname,'Obj');
                    fname = [folder_name_sub,'/Dec_',num2str(ind_wts),'.mat'];
                    save(fname,'Dec');
                    fname = [folder_name_sub,'/Con_',num2str(ind_wts),'.mat'];
                    save(fname,'Con');
                end

                % Save the weights
                fname = [folder_name_sub,'/wts.mat'];
                save(fname,'wts');
        end

        % Reset path after running PlatEMO
        cd(path_main)
    end
end


function W = simplex_grid(m, K)
% All weight vectors in R^m with entries in {0, 1/K, ..., 1} summing to 1,
% built on an integer grid so the sum test is exact.
    grids = cell(1, m);
    [grids{:}] = ndgrid(0:K);
    G = cell2mat(cellfun(@(g) g(:), grids, 'UniformOutput', false));
    W = (G(sum(G, 2) == K, :) / K)';
end